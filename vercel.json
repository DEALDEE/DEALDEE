
{
  "rewrites": [
    {
      "source": "/b/:path*",
      "destination": "/DEALDEE/b/:path*"
    },
    {
      "source": "/a/:path*",
      "destination": "/DEALDEE/a/:path*"
    },
    {
      "source": "/home/:path*",
      "destination": "/DEALDEE/home/:path*"
    },
    {
      "source": "/",
      "destination": "/DEALDEE/home/index.html"
    }
  ]
}
